{
  "name": "sunny-img",
  "version": "0.0.1",
  "description": "A lightweight React image component inspired by next/image",
  "keywords": ["react", "image", "responsive-image", "lazy-loading"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukonik/sunny-img.git",
    "directory": "packages/sunny-img"
  },
  "homepage": "https://github.com/lukonik/sunny-img#readme",
  "bugs": {
    "url": "https://github.com/lukonik/sunny-img/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "prepublishOnly": "pnpm test && pnpm typecheck && pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.15.0",
    "typescript": "^6.0.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
